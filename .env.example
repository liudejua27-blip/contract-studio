# Contract Studio local example. Copy to .env locally; never commit the copy.
# The defaults below are placeholders or local endpoints, not production values.

# These names match src/server/auth.ts, the CSRF guard, and src/server/contracts.ts.
APP_BASE_URL=http://127.0.0.1:3210
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3210
CONTRACT_SESSION_SECRET=replace-with-local-secret

# Keep demo explicit until a real model is configured and evaluated. These names
# match src/server/ai.ts; OPENAI_* aliases are also accepted by that module.
CONTRACT_DEMO_MODE=true
CONTRACT_AI_BASE_URL=https://api.deepseek.com
CONTRACT_AI_MODEL=deepseek-flash
CONTRACT_AI_API_KEY=
CONTRACT_AI_TIMEOUT_MS=240000
# Full Pi SDK private sessions, scoped by authenticated owner + contract.
# Node workflows store canonical checkpoints in PostgreSQL; this private directory
# is temporary SDK scratch space and the import source for legacy local sessions.
CONTRACT_PI_SESSION_DIR=.data/pi-sessions
CONTRACT_AI_CONTEXT_WINDOW=64000
# Optional output allowance override. Defaults: intake/verify 16384, draft/patch 24576.
# On truncation, grow the allowance and request incremental output up to this ceiling.
# Match these values to the configured provider/model output limit.
# CONTRACT_AI_MAX_OUTPUT_TOKENS=16384
CONTRACT_AI_MAX_RECOVERY_TOKENS=65536
# All model stages default to Flash Thinking high, including intake.
CONTRACT_AI_THINKING=enabled
CONTRACT_AI_REASONING_EFFORT=high

# Verified host PostgreSQL database created for this project.
DATABASE_URL=postgresql://127.0.0.1:5432/contract_studio
# If the compose infra profile is used instead, replace DATABASE_URL with:
# DATABASE_URL=postgresql://contract_studio:replace-with-local-password@127.0.0.1:55432/contract_studio

# File storage. The code selects S3 when S3_BUCKET is present; leave it unset
# for the private filesystem fallback during local development.
CONTRACT_STORAGE_DRIVER=filesystem
CONTRACT_PRIVATE_STORAGE_DIR=.data/private-files
# Optional MinIO profile values. Uncomment all of these together when using S3.
# S3_ENDPOINT=http://127.0.0.1:59000
# S3_REGION=us-east-1
# S3_BUCKET=contract-studio
# AWS_ACCESS_KEY_ID=replace-with-s3-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-local-secret
# S3_FORCE_PATH_STYLE=true

# Existing healthy host service. Its JWT secret is intentionally blank here and
# must be supplied through a local secret channel before online editing works.
ONLYOFFICE_URL=http://127.0.0.1:8081
# Keep the browser origin on APP_BASE_URL. These two optional bases are separate
# because DocumentServer runs in Docker and cannot call a host-side 127.0.0.1.
# ONLYOFFICE_DOCUMENT_BASE_URL=http://127.0.0.1:3210
# ONLYOFFICE_CALLBACK_BASE_URL=http://host.docker.internal:3210
# Development-only allowlist needed for the HTTP Docker host callback above.
# ONLYOFFICE_ALLOW_PRIVATE_HOSTS=host.docker.internal
# The implementation also accepts OO_CALLBACK_BASE_URL for older local setups.

# If the optional onlyoffice profile is started, use this browser-facing URL
# and set ONLYOFFICE_JWT_SECRET to a new local-only value.
# ONLYOFFICE_URL=http://127.0.0.1:8082

# Background jobs start automatically with the long-lived Node server (dev/start).
# Run db:init before starting a fresh database. Browser disconnects do not cancel jobs.
# PostgreSQL and private S3 objects must survive server restarts. Shared SDK
# checkpoints allow a different worker host to resume without a shared local disk.

# Per-account admission, shared across Node instances; automatic retries are not charged.
CONTRACT_AI_MAX_ACTIVE_PER_USER=1
CONTRACT_AI_REQUESTS_PER_HOUR=40

# Node worker scheduling. embedded keeps local dev self-contained; external makes
# the web process submit/observe only. In production run workers:autoscale separately.
CONTRACT_WORKER_MODE=embedded
CONTRACT_WORKER_CONCURRENCY=30
CONTRACT_WORKER_POLL_MS=1000
# Seeded into PostgreSQL on db:init. Subsequent changes require workers:configure;
# all workers read the same policy regardless of their environment variables.
CONTRACT_AI_GLOBAL_CONCURRENCY=120
CONTRACT_AI_INTAKE_RESERVE=20
CONTRACT_AI_MAX_QUEUED=1000
# Automatic local process scaling. More hosts can run the same supervisor against
# the same PostgreSQL and private S3 bucket; the total cap is still shared.
CONTRACT_WORKERS_MIN=1
CONTRACT_WORKERS_MAX=4
CONTRACT_AUTOSCALE_INTERVAL_MS=5000
CONTRACT_AUTOSCALE_COOLDOWN_MS=60000
CONTRACT_WORKER_SHUTDOWN_MS=660000

# Trust only a reverse proxy that overwrites these headers; Node must not be public.
CONTRACT_TRUST_PROXY=false
# Transactional email. Production requires valid TLS / STARTTLS; no mail is sent
# until a user requests verification or password recovery.
CONTRACT_SMTP_HOST=
CONTRACT_SMTP_PORT=587
CONTRACT_SMTP_SECURE=false
CONTRACT_SMTP_USER=
CONTRACT_SMTP_PASSWORD=
CONTRACT_MAIL_FROM=
CONTRACT_REQUIRE_VERIFIED_EMAIL=false
# Initial administrator only, then remove this variable and private bootstrap file.
CONTRACT_BOOTSTRAP_ADMIN_EMAIL=
# Optional directory containing pg_dump and pg_restore, compatible with server version.
CONTRACT_PG_BIN_DIR=
# Prices use the operator's chosen currency per million tokens. Blank means unknown.
CONTRACT_MODEL_INPUT_PRICE_PER_MILLION=
CONTRACT_MODEL_OUTPUT_PRICE_PER_MILLION=
CONTRACT_ALERT_QUEUE_SECONDS=120
CONTRACT_ALERT_FAILURE_RATIO=0.2
CONTRACT_ALERT_DAILY_COST=100

# Optional on-demand official-source legal search via Tavily. Never expose to browser.
CONTRACT_LEGAL_SEARCH_API_KEY=

# Per background task, shared by draft/verification/repairs and persisted in workflow.
# Explicit retries keep the same budget. Changes below apply to newly started tasks.
CONTRACT_TASK_MAX_TOKENS=2000000
CONTRACT_TASK_MAX_MODEL_CALLS=36
# Starts at first worker claim; includes pauses between phases. Not a per-call timeout.
CONTRACT_TASK_MAX_DURATION_MS=900000

# Optional LOCAL scanned-PDF recognition. Install Poppler + Tesseract and language data
# on web/upload hosts first. Document bytes are never sent to an OCR service.
CONTRACT_OCR_ENABLED=false
CONTRACT_OCR_MAX_PAGES=5
CONTRACT_OCR_TIMEOUT_MS=45000
CONTRACT_OCR_LANG=chi_sim+eng
CONTRACT_PDFTOPPM_BIN=pdftoppm
CONTRACT_TESSERACT_BIN=tesseract
