# Contract Studio local example. Copy to .env locally; never commit the copy.
# The defaults below are placeholders or local endpoints, not production values.

# These names match src/server/auth.ts, the CSRF guard, and src/server/contracts.ts.
APP_BASE_URL=http://127.0.0.1:3210
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3210
CONTRACT_SESSION_SECRET=replace-with-local-secret

# Keep demo explicit until a real model is configured and evaluated. These names
# match src/server/ai.ts; OPENAI_* aliases are also accepted by that module.
CONTRACT_DEMO_MODE=true
CONTRACT_AI_BASE_URL=https://api.deepseek.com
CONTRACT_AI_MODEL=deepseek-v4-pro
CONTRACT_AI_API_KEY=
CONTRACT_AI_TIMEOUT_MS=180000

# Verified host PostgreSQL database created for this project.
DATABASE_URL=postgresql://127.0.0.1:5432/contract_studio
# If the compose infra profile is used instead, replace DATABASE_URL with:
# DATABASE_URL=postgresql://contract_studio:replace-with-local-password@127.0.0.1:55432/contract_studio

# File storage. The code selects S3 when S3_BUCKET is present; leave it unset
# for the private filesystem fallback during local development.
CONTRACT_STORAGE_DRIVER=filesystem
CONTRACT_PRIVATE_STORAGE_DIR=.data/private-files
# Optional MinIO profile values. Uncomment all of these together when using S3.
# S3_ENDPOINT=http://127.0.0.1:59000
# S3_REGION=us-east-1
# S3_BUCKET=contract-studio
# AWS_ACCESS_KEY_ID=contract_studio_minio
# AWS_SECRET_ACCESS_KEY=replace-with-local-secret
# S3_FORCE_PATH_STYLE=true

# Existing healthy host service. Its JWT secret is intentionally blank here and
# must be supplied through a local secret channel before online editing works.
ONLYOFFICE_URL=http://127.0.0.1:8081
# Keep the browser origin on APP_BASE_URL. These two optional bases are separate
# because DocumentServer runs in Docker and cannot call a host-side 127.0.0.1.
# ONLYOFFICE_DOCUMENT_BASE_URL=http://127.0.0.1:3210
# ONLYOFFICE_CALLBACK_BASE_URL=http://host.docker.internal:3210
# Development-only allowlist needed for the HTTP Docker host callback above.
# ONLYOFFICE_ALLOW_PRIVATE_HOSTS=host.docker.internal
# The implementation also accepts OO_CALLBACK_BASE_URL for older local setups.

# If the optional onlyoffice profile is started, use this browser-facing URL
# and set ONLYOFFICE_JWT_SECRET to a new local-only value.
# ONLYOFFICE_URL=http://127.0.0.1:8082
