# Inside an HTTPS server block. Set APP_BASE_URL to its public https:// origin.
# Keep Node bound to 127.0.0.1; the public must not reach it directly.
client_max_body_size 30m;
client_body_timeout 30s;
location / {
    proxy_pass http://127.0.0.1:3210;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 60s;
}
# Do not log signed OnlyOffice URL query strings. Configure a log_format using
# $uri (not $request or $request_uri) in the http block and use it here.
