[Unit]
Description=Contract Studio operational checks (exit 2 means alert)
After=network-online.target
[Service]
Type=oneshot
User=contract-studio
WorkingDirectory=/opt/contract-studio
EnvironmentFile=/etc/contract-studio/server.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run ops:monitor
UMask=0077
NoNewPrivileges=true
