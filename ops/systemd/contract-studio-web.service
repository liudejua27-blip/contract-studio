[Unit]
Description=Contract Studio web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contract-studio
WorkingDirectory=/opt/contract-studio
EnvironmentFile=/etc/contract-studio/server.env
Environment=NODE_ENV=production
Environment=CONTRACT_WORKER_MODE=external
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
