{
  "name": "contract-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "npm run build:server",
    "start": "CONTRACT_BUILD_DIR=.next-build next start --hostname 127.0.0.1 --port 3210",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:init": "node --env-file=.env.local --import tsx scripts/setup.ts",
    "build:node": "npm run build:skills && CONTRACT_BUILD_DIR=.next-build next build",
    "build:workers": "node scripts/build-workers.mjs",
    "build:server": "npm run build:node && npm run build:workers",
    "worker": "node .worker-build/agent-worker.mjs",
    "workers:autoscale": "node .worker-build/agent-supervisor.mjs",
    "workers:status": "node .worker-build/agent-operations.mjs",
    "workers:configure": "node .worker-build/agent-operations.mjs --configure",
    "check:release": "npm run typecheck && npm test && npm run build && npm run test:server",
    "test:server": "node --env-file=.env.local --import tsx scripts/server-smoke.ts",
    "ops:backup": "node .worker-build/backup.mjs",
    "ops:maintenance": "node .worker-build/maintenance.mjs",
    "ops:backfill-review-text": "node .worker-build/backfill-review-text.mjs",
    "ops:monitor": "node .worker-build/monitor.mjs",
    "admin:bootstrap": "node .worker-build/bootstrap-admin.mjs",
    "db:migrate": "node .worker-build/setup.mjs",
    "test:backup": "node --env-file=.env.local --import tsx scripts/backup-smoke.ts",
    "eval:intake": "node --env-file=.env.local --import tsx scripts/eval-contract-intake.ts",
    "build:skills": "node scripts/build-legal-skills.mjs",
    "predev": "npm run build:skills",
    "eval:tasks": "node --import tsx scripts/eval-tasks.ts",
    "eval:feedback": "node --env-file=.env.local --import tsx scripts/eval-feedback.ts",
    "test:ui:safety": "node --import tsx scripts/audit-ui-smoke.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.11.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@onlyoffice/document-editor-react": "^2.0.0",
    "docx": "^9.5.1",
    "docx-preview": "^0.3.6",
    "fflate": "^0.8.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "nodemailer": "10.0.10",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.16.3",
    "proper-lockfile": "4.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typebox": "1.3.27",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "overrides": {
    "postcss": "8.5.28"
  }
}
